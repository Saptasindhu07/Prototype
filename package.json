{
  "name": "research-similarity-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server"],
  "engines": { "node": ">=24" },
  "scripts": {
    "setup": "node scripts/setup-env.js",
    "dev": "concurrently --kill-others -n api,web \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:check": "npm run db:check --workspace server"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
