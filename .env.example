NODE_ENV=development
HOST=127.0.0.1
PORT=5000
CLIENT_ORIGIN=http://127.0.0.1:5173

# Keep false until the selected model bundle is verified and connected together.
AI_RECOMMENDATIONS_ENABLED=false
AI_INFERENCE_URL=http://127.0.0.1:8100

# Local development credentials. npm run setup generates a random password.
MONGO_ROOT_USERNAME=research_dev
MONGO_ROOT_PASSWORD=replace-with-local-password
MONGODB_URI=mongodb://research_dev:replace-with-local-password@127.0.0.1:27017/research_similarity?authSource=admin
